# Copy to .env.local for local dev; set the same names in Vercel for production.
# Real values are never committed — .env* is gitignored.

TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Signs the session cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=

# Google OAuth web client (Google Cloud Console → Credentials).
# Sign-in fails closed when these are unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on that client, exactly.
# Default is http://localhost:5173/api/auth/callback (vite, via `npm run dev`).
# Use port 3001 instead if you run `npm start`.
OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Day boundaries for the checklist and the stats. Default Asia/Jakarta.
APP_TZ=Asia/Jakarta

# --- the 9pm report -------------------------------------------------------
# Vercel sets this header on its cron calls; without it the endpoint is closed
# to everyone, the scheduler included.
CRON_SECRET=

# Gmail SMTP. GMAIL_APP_PASSWORD is a 16-character App Password from
# https://myaccount.google.com/apppasswords — not the account password, and it
# needs 2-step verification switched on first.
GMAIL_USER=
GMAIL_APP_PASSWORD=
REPORT_TO=singgih.rochmad@gmail.com,titis.ekaaprilia@gmail.com

# Used for the links in the email; defaults to the production URL.
APP_URL=https://weekly-checklist-xnk2.vercel.app
